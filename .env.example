# Copy relevant values into backend/.env and frontend/.env.
# Use dedicated development resources only. Values below are placeholders.
APP_ENV=development
APP_NAME=Axiom Delivery AI

DATABASE_URL=postgresql+psycopg://delivery_user:replace-me@localhost:5432/ai_delivery_platform
DATABASE_SECRET_ARN=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ai_delivery_platform
RUN_SCHEMA_CREATE=false

AI_PROVIDER=openai
OPENAI_API_KEY=replace-with-development-key
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_INFERENCE_PROFILE_ID=
BEDROCK_MAX_TOKENS=2048
BEDROCK_TEMPERATURE=0.2
BEDROCK_TOP_P=0.9

# Provision isolated development Cognito resources.
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=replace-with-development-user-pool-id
COGNITO_CLIENT_ID=replace-with-development-client-id
VITE_COGNITO_USER_POOL_ID=replace-with-development-user-pool-id
VITE_COGNITO_CLIENT_ID=replace-with-development-client-id
VITE_COGNITO_DOMAIN=replace-with-development-domain.auth.us-east-1.amazoncognito.com
VITE_AUTH_REDIRECT_URI=http://localhost:5173
# Cognito is optional on localhost only. Non-local builds remain fail-closed.

VITE_API_URL=http://localhost:8000
# Use the local delivery demo dataset until /api/delivery/command-center is available.
VITE_USE_MOCK_DELIVERY_DATA=true
USE_MOCK_DELIVERY_DATA=false
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1
ENABLE_API_DOCS=true
SYNC_TOOL_CATALOG_ON_STARTUP=false

TOOL_FILE_ALLOWED_ROOTS=
TOOL_FILE_ALLOWED_EXTENSIONS=.txt,.md,.json,.csv
TOOL_FILE_MAX_BYTES=10485760
MCP_ALLOW_PRIVATE_NETWORK=false
MCP_MAX_SCHEMA_BYTES=1048576
TOOL_DISCOVERY_EMBEDDING_PROVIDER=
TOOL_DISCOVERY_EMBEDDING_DIMENSIONS=1536
TOOL_DISCOVERY_MAX_CANDIDATES=100
TOOL_DISCOVERY_TIMEOUT_SECONDS=10
TOOL_DISCOVERY_RATE_LIMIT_PER_MINUTE=60
TOOL_DISCOVERY_INDEX_BATCH_SIZE=100
TOOL_DISCOVERY_CANDIDATE_RETENTION_DAYS=30

# Optional integrations: leave blank until isolated resources exist.
SERVICENOW_INSTANCE_URL=
SERVICENOW_ACCESS_TOKEN=
SERVICENOW_TIMEOUT_SECONDS=30
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
MICROSOFT_GRAPH_ACCESS_TOKEN=
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
AZURE_BLOB_ENDPOINT=
AZURE_BLOB_ACCESS_TOKEN=
AZURE_BLOB_ALLOWED_CONTAINERS=
AZURE_KEYVAULT_URI=
AZURE_KEYVAULT_ACCESS_TOKEN=
NATIVE_FILE_STORAGE_ROOT=
NATIVE_FILE_MAX_BYTES=10485760
NOTIFICATION_ALLOWED_EMAIL_DOMAINS=
